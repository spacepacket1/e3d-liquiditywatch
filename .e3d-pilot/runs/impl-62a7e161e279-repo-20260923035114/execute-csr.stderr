+
+function allocationFromControl(control) {
+  const raw = control.value;
+  const isOwnOption = Array.from(control.options).some((option) => option.value === raw);
+  return isOwnOption ? parseInt(raw, 10) : NaN;
+}
+
+function currentExposureMix() {
